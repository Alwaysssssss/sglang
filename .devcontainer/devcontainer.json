{
    "name": "sglang",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "remoteUser": "devuser",
    "mounts": [
      "source=/home/model/models,target=/home/model/models,type=bind",
      "source=/usr/lib/node_modules/@openai/codex,target=/usr/lib/node_modules/@openai/codex,type=bind,readonly",
    //   "source=/usr/lib/node_modules/@anthropic-ai/claude-code,target=/usr/lib/node_modules/@anthropic-ai/claude-code,type=bind,readonly",
      "source=/home/zhiheng/.codex,target=/home/devuser/.codex,type=bind"
    ],
    "containerEnv": {
        "CODEX_HOME": "/home/devuser/.codex"
    },
    "postCreateCommand": "sudo ln -sf /usr/lib/node_modules/@openai/codex/bin/codex.js /usr/local/bin/codex",
    "customizations": {
        "vscode": {
            "extensions": [
                // Python development
                "ms-python.python",
                "charliermarsh.ruff",
                // Rust development
                "rust-lang.rust-analyzer",
                "tamasfe.even-better-toml"
            ]
        }
    },
    "forwardPorts": [],
    "runArgs": [
        "--gpus",
        "all"
    ],
    // The two lines below ensures that your local changes in the sglang
    // repo is automatically synced to the sglang pip package installed
    // in the dev docker container. You can remove / comment out these
    // two lines if you prefer to sync code changes manually.
    "workspaceMount": "source=${localWorkspaceFolder},target=/sgl-workspace/sglang,type=bind",
    "workspaceFolder": "/sgl-workspace/sglang"
}
