# Dedicated GPU 6/7 normal+DMD service on host port 5403.
# Same stack and measured two-rank profile as config.l40s.45.u2.env, with a
# dedicated runtime directory to isolate locks, PIDs, queues and outputs.
PROJECT_ROOT=/home/zhouhao6/VideoEdit/sglang
PYTHON_BIN=python3
SGLANG_BIN=/usr/local/bin/sglang

BASE_MODEL=/home/zhouhao6/VideoEdit/model/DifusserEdit/pretrain_models/VideoEdit-diffusers-model
NORMAL_TRANSFORMER=/home/zhouhao6/VideoEdit/model/DifusserEdit/pretrain_models/VideoEdit-diffusers-model/transformer
DMD_TRANSFORMER=/home/zhouhao6/VideoEdit/model/DifusserEdit/merged_dit_lightx2v_lora_scale_1p0

# Docker exposes physical GPUs 6,7 as CUDA devices 0,1.
# Container-visible GPUs; environment overrides take precedence in start.sh.
CUDA_DEVICES=0,1
NUM_GPUS=2
SP_DEGREE=2
ULYSSES_DEGREE=2
RING_DEGREE=1

RUNTIME_DIR=/home/zhouhao6/VideoEdit/sglang/.local/videoedit-l40s.67-u2-5403/dual
LOG_DIR=/home/zhouhao6/VideoEdit/sglang/.local/videoedit-l40s.67-u2-5403/dual/logs
PID_DIR=/home/zhouhao6/VideoEdit/sglang/.local/videoedit-l40s.67-u2-5403/dual/pids
QUEUE_DB=/home/zhouhao6/VideoEdit/sglang/.local/videoedit-l40s.67-u2-5403/dual/queue.sqlite3
OUTPUT_DIR=/home/zhouhao6/VideoEdit/sglang/.local/videoedit-l40s.67-u2-5403/outputs
INPUT_DIR=/home/zhouhao6/VideoEdit/sglang/.local/videoedit-l40s.67-u2-5403/dual/inputs

GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=30000
NORMAL_PORT=31100
NORMAL_BROKER_PORT=31101
NORMAL_MASTER_PORT=31105
NORMAL_SCHEDULER_PORT=31755
NORMAL_NCCL_PORT=31955
DMD_PORT=32100
DMD_BROKER_PORT=32101
DMD_MASTER_PORT=32105
DMD_SCHEDULER_PORT=32755
DMD_NCCL_PORT=32955

STARTUP_TIMEOUT=1800
STARTUP_STABLE_SECONDS=10
SCHEDULER_RESPONSE_TIMEOUT=-1
MIN_STARTUP_GPU_HEADROOM_GIB=2
MIN_IDLE_GPU_HEADROOM_GIB=4
MIN_HOST_HEADROOM_GIB=40
MIN_CGROUP_HEADROOM_GIB=40

# Both backends stay loaded; the gateway serializes requests across models.
ENABLE_DMD=true
# Enable the measured two-rank adaptive residency profile: small inputs cache all
# layers; full-frame inputs reduce residency. Set SGLANG_VIDEOEDIT_AUTO_RESIDENCY=0 to opt out.
SGLANG_VIDEOEDIT_AUTO_RESIDENCY=1
# Release GPU copies after DiT without copying immutable weights back to CPU.
DIT_LAYERWISE_OFFLOAD=true
DIT_CPU_OFFLOAD=false
VIDEOEDIT_STAGE_RESIDENT_PROBE=false
# Benchmark hooks require TeaCache=0.3 and reject valid DMD requests.
VIDEOEDIT_LAYERWISE_PROBE=false
DIT_OFFLOAD_PREFETCH_SIZE=4
SGLANG_VIDEOEDIT_OVERLAP_PREFETCH=0
SGLANG_VIDEOEDIT_FUSED_QKV=0
SGLANG_VIDEOEDIT_RESIDENT_LAYERS=40
SGLANG_VIDEOEDIT_RELEASE_AFTER_DENOISE=1
# Retain CPU encoder originals; release GPU copies without D2H weight transfers.
SGLANG_VIDEOEDIT_ENCODER_CPU_MASTER=1
ATTENTION_BACKEND=fa
SKIP_SECOND_SERVICE_RESOURCE_GATE=false
SGLANG_USE_RUNAI_MODEL_STREAMER=false
PIN_CPU_MEMORY=true
# Avoid huge-page compaction stalls in NumPy and FFmpeg on this host.
# Applies only to newly launched backend processes and their descendants.
VIDEOEDIT_DISABLE_THP=true
VIDEOEDIT_QUEUE_CAPACITY=1

# Request text is encoded on rank 0 while rank 1 handles CLIP. The default
# negative prompt is prepared before readiness and retained on CPU.
SGLANG_VIDEOEDIT_PARALLEL_CONDITIONING=1
SGLANG_VIDEOEDIT_TEXT_OWNER=0
SGLANG_VIDEOEDIT_CLIP_OWNER=1

# Measured two-rank spatial tiling for both condition encode and decode.
VIDEOEDIT_VAE_SP=true
SGLANG_VIDEOEDIT_VAE_SP_MODE=both
SGLANG_VIDEOEDIT_VAE_ENCODE_DEGREE=2
SGLANG_VIDEOEDIT_VAE_DECODE_DEGREE=2

# The gateway routes both model variants.
VIDEOEDIT_GATEWAY_POLL_INTERVAL=1
VIDEOEDIT_GATEWAY_HEALTH_TIMEOUT=2
