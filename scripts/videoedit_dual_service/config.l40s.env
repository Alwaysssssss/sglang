# Copy to config.env and adjust for the target host.
PROJECT_ROOT=/home/zhouhao6/VideoEdit/sglang
PYTHON_BIN=python3
SGLANG_BIN=/usr/local/bin/sglang

BASE_MODEL=/home/zhouhao6/VideoEdit/model/DifusserEdit/pretrain_models/VideoEdit-diffusers-model
NORMAL_TRANSFORMER=/home/zhouhao6/VideoEdit/model/DifusserEdit/pretrain_models/VideoEdit-diffusers-model/transformer
DMD_TRANSFORMER=/home/zhouhao6/VideoEdit/model/DifusserEdit/merged_dit_lightx2v_lora_scale_1p0

CUDA_DEVICES=0,1
RUNTIME_DIR=/home/zhouhao6/VideoEdit/sglang/.local/videoedit-l40s/dual
LOG_DIR=/home/zhouhao6/VideoEdit/sglang/.local/videoedit-l40s/dual/logs
PID_DIR=/home/zhouhao6/VideoEdit/sglang/.local/videoedit-l40s/dual/pids
QUEUE_DB=/home/zhouhao6/VideoEdit/sglang/.local/videoedit-l40s/dual/queue.sqlite3
OUTPUT_DIR=/home/zhouhao6/VideoEdit/sglang/.local/videoedit-l40s/outputs
INPUT_DIR=/home/zhouhao6/VideoEdit/sglang/.local/videoedit-l40s/dual/inputs

GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=30000
NORMAL_PORT=31100
NORMAL_BROKER_PORT=31101
NORMAL_MASTER_PORT=31105
NORMAL_SCHEDULER_PORT=31755
NORMAL_NCCL_PORT=31955
DMD_PORT=32100
DMD_BROKER_PORT=32101
DMD_MASTER_PORT=32105
DMD_SCHEDULER_PORT=32755
DMD_NCCL_PORT=32955

STARTUP_TIMEOUT=900
STARTUP_STABLE_SECONDS=10
SCHEDULER_RESPONSE_TIMEOUT=-1
MIN_STARTUP_GPU_HEADROOM_GIB=2
MIN_IDLE_GPU_HEADROOM_GIB=4
MIN_HOST_HEADROOM_GIB=40
MIN_CGROUP_HEADROOM_GIB=40

SKIP_SECOND_SERVICE_RESOURCE_GATE=true
SGLANG_USE_RUNAI_MODEL_STREAMER=false
PIN_CPU_MEMORY=true
# Avoid huge-page compaction stalls in NumPy and FFmpeg on this host.
# Applies only to newly launched backend processes and their descendants.
VIDEOEDIT_DISABLE_THP=true
VIDEOEDIT_QUEUE_CAPACITY=1

# The gateway keeps normal available in degraded mode when DMD cannot start.
VIDEOEDIT_GATEWAY_POLL_INTERVAL=1
VIDEOEDIT_GATEWAY_HEALTH_TIMEOUT=2
