# Copy to config.env and adjust for the target host.
PROJECT_ROOT=/mnt/nas/models/test/sglang
PYTHON_BIN=python3
SGLANG_BIN=/usr/local/bin/sglang

BASE_MODEL=/mnt/nas/models/DifusserEdit/pretrain_models/VideoEdit-diffusers-model
NORMAL_TRANSFORMER=/mnt/nas/models/latest_edit/step-55000-diffusers-lh/transformer
DMD_TRANSFORMER=/mnt/nas/models/latest_edit/merged_dit_lightx2v_lora_scale_1p0

CUDA_DEVICES=0,1
RUNTIME_DIR=/mnt/nas/models/test/sglang/runtime/videoedit-dual
LOG_DIR=/mnt/nas/models/test/sglang/runtime/videoedit-dual/logs
PID_DIR=/mnt/nas/models/test/sglang/runtime/videoedit-dual/pids
QUEUE_DB=/mnt/nas/models/test/sglang/runtime/videoedit-dual/queue.sqlite3
OUTPUT_DIR=/mnt/nas/models/test/sglang/outputs/videoedit-dual
INPUT_DIR=/mnt/nas/models/test/sglang/runtime/videoedit-dual/inputs

GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=30000
NORMAL_PORT=31100
NORMAL_BROKER_PORT=31101
NORMAL_MASTER_PORT=31105
NORMAL_SCHEDULER_PORT=31755
NORMAL_NCCL_PORT=31955
DMD_PORT=32100
DMD_BROKER_PORT=32101
DMD_MASTER_PORT=32105
DMD_SCHEDULER_PORT=32755
DMD_NCCL_PORT=32955

STARTUP_TIMEOUT=900
STARTUP_STABLE_SECONDS=10
SCHEDULER_RESPONSE_TIMEOUT=-1
MIN_STARTUP_GPU_HEADROOM_GIB=2
MIN_IDLE_GPU_HEADROOM_GIB=4
MIN_HOST_HEADROOM_GIB=40
MIN_CGROUP_HEADROOM_GIB=40

SGLANG_USE_RUNAI_MODEL_STREAMER=false
PIN_CPU_MEMORY=true
VIDEOEDIT_QUEUE_CAPACITY=1

# The gateway keeps normal available in degraded mode when DMD cannot start.
VIDEOEDIT_GATEWAY_POLL_INTERVAL=1
VIDEOEDIT_GATEWAY_HEALTH_TIMEOUT=2
