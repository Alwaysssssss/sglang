#!/usr/bin/env python3
"""Compare L20 BF16 and FP8 GEMM backends on audited VideoEdit shapes."""

from __future__ import annotations

import argparse
import json
import statistics
import subprocess
from datetime import datetime, timezone
from pathlib import Path
from typing import Any, Callable


def load_shapes(path: Path, max_m: int, max_shapes: int) -> list[dict[str, int]]:
    records = json.loads(path.read_text(encoding="utf-8"))
    by_shape: dict[tuple[int, int, int], dict[str, int]] = {}
    for record in records:
        if record.get("method") != "Fp8LinearMethod":
            continue
        if "fp8_scaled_mm" not in str(record.get("kernel", "")):
            continue
        try:
            original_m = int(record["m"])
            k = int(record["k"])
            n = int(record["n"])
        except (KeyError, TypeError, ValueError):
            continue
        shape = {
            "original_m": original_m,
            "m": min(original_m, max_m),
            "k": k,
            "n": n,
        }
        by_shape[(shape["m"], k, n)] = shape

    return sorted(
        by_shape.values(),
        key=lambda shape: 2 * shape["original_m"] * shape["k"] * shape["n"],
        reverse=True,
    )[:max_shapes]


def elapsed_ms(
    torch,
    fn: Callable[[], Any],
    warmups: int,
    iterations: int,
) -> tuple[float, list[float]]:
    for _ in range(warmups):
        fn()
    torch.cuda.synchronize()

    values: list[float] = []
    for _ in range(iterations):
        start = torch.cuda.Event(enable_timing=True)
        end = torch.cuda.Event(enable_timing=True)
        start.record()
        fn()
        end.record()
        end.synchronize()
        values.append(float(start.elapsed_time(end)))
    return statistics.median(values), values


def query_gpu_state() -> dict[str, str] | None:
    fields = [
        "name",
        "clocks.sm",
        "clocks.max.sm",
        "power.draw",
        "power.limit",
        "temperature.gpu",
        "utilization.gpu",
        "clocks_throttle_reasons.active",
    ]
    command = [
        "nvidia-smi",
        f"--query-gpu={','.join(fields)}",
        "--format=csv,noheader,nounits",
        "--id=0",
    ]
    try:
        output = subprocess.run(
            command,
            check=True,
            capture_output=True,
            text=True,
            timeout=10,
        ).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return None
    values = [value.strip() for value in output.split(",")]
    return dict(zip(fields, values, strict=False))


def per_tensor_fp8(torch, tensor):
    fp8_max = torch.finfo(torch.float8_e4m3fn).max
    scale = tensor.abs().amax().float() / fp8_max
    scale = torch.clamp(scale, min=torch.finfo(torch.float32).tiny)
    quantized = torch.clamp(tensor / scale, -fp8_max, fp8_max).to(torch.float8_e4m3fn)
    return quantized, scale.reshape(1)


def similarity(torch, reference, candidate) -> dict[str, float]:
    import torch.nn.functional as functional

    reference_f = reference.float()
    candidate_f = candidate.float()
    cosine = functional.cosine_similarity(
        reference_f.flatten(),
        candidate_f.flatten(),
        dim=0,
    ).item()
    rmse = torch.mean((reference_f - candidate_f) ** 2).sqrt()
    normalized_rmse = (
        rmse / torch.clamp(reference_f.square().mean().sqrt(), min=1e-12)
    ).item()
    return {
        "cosine_similarity": float(cosine),
        "normalized_rmse": float(normalized_rmse),
    }


def benchmark_shape(
    shape: dict[str, int],
    *,
    warmups: int,
    iterations: int,
) -> dict[str, Any]:
    import torch
    import torch.nn.functional as functional
    from sgl_kernel import fp8_scaled_mm

    from sglang.srt.layers.quantization.fp8_kernel import (
        per_token_group_quant_fp8,
        sglang_per_token_quant_fp8,
    )
    from sglang.srt.layers.quantization.fp8_utils import triton_scaled_mm

    m, k, n = shape["m"], shape["k"], shape["n"]
    device = torch.device("cuda", 0)
    torch.cuda.empty_cache()
    torch.cuda.reset_peak_memory_stats(device)

    x = torch.randn((m, k), device=device, dtype=torch.bfloat16)
    weight = torch.randn((n, k), device=device, dtype=torch.bfloat16)

    qinput_row, input_scale_row = sglang_per_token_quant_fp8(x)
    qweight_row, weight_scale_row = per_token_group_quant_fp8(weight, k)
    qweight_row_t = qweight_row.t()
    weight_scale_row_t = weight_scale_row.t().contiguous()

    qinput_tensor, input_scale_tensor = per_tensor_fp8(torch, x)
    qweight_tensor, weight_scale_tensor = per_tensor_fp8(torch, weight)
    qweight_tensor_t = qweight_tensor.t()

    def bf16_op():
        return functional.linear(x, weight)

    def sgl_gemm_op():
        return fp8_scaled_mm(
            qinput_row,
            qweight_row_t,
            input_scale_row,
            weight_scale_row_t,
            torch.bfloat16,
            bias=None,
        )

    def sgl_dynamic_op():
        dynamic_qinput, dynamic_scale = sglang_per_token_quant_fp8(x)
        return fp8_scaled_mm(
            dynamic_qinput,
            qweight_row_t,
            dynamic_scale,
            weight_scale_row_t,
            torch.bfloat16,
            bias=None,
        )

    def activation_quant_op():
        return sglang_per_token_quant_fp8(x)

    def torch_scaled_mm_op(use_fast_accum: bool):
        return torch._scaled_mm(
            qinput_tensor,
            qweight_tensor_t,
            input_scale_tensor,
            weight_scale_tensor,
            out_dtype=torch.bfloat16,
            use_fast_accum=use_fast_accum,
        )

    def triton_gemm_op():
        return triton_scaled_mm(
            qinput_row,
            qweight_row_t,
            input_scale_row,
            weight_scale_row_t,
            torch.bfloat16,
            None,
        )

    def triton_dynamic_op():
        dynamic_qinput, dynamic_scale = sglang_per_token_quant_fp8(x)
        return triton_scaled_mm(
            dynamic_qinput,
            qweight_row_t,
            dynamic_scale,
            weight_scale_row_t,
            torch.bfloat16,
            None,
        )

    bf16_median, bf16_values = elapsed_ms(torch, bf16_op, warmups, iterations)
    flops = 2 * m * k * n
    result: dict[str, Any] = {
        **shape,
        "flops": flops,
        "bf16": {
            "median_ms": bf16_median,
            "values_ms": bf16_values,
            "tflops": flops / (bf16_median / 1000) / 1e12,
        },
        "providers": {},
    }

    quant_median, quant_values = elapsed_ms(
        torch,
        activation_quant_op,
        warmups,
        iterations,
    )
    result["activation_quant"] = {
        "median_ms": quant_median,
        "values_ms": quant_values,
        "input_gbps": x.numel() * x.element_size() / (quant_median / 1000) / 1e9,
    }

    sample_rows = min(m, 64)
    sample_x = x[:sample_rows]
    reference = functional.linear(sample_x, weight)

    providers: list[tuple[str, Callable[[], Any], Callable[[], Any]]] = [
        (
            "torch_scaled_mm_scalar",
            lambda: torch_scaled_mm_op(False),
            lambda: torch._scaled_mm(
                per_tensor_fp8(torch, sample_x)[0],
                qweight_tensor_t,
                per_tensor_fp8(torch, sample_x)[1],
                weight_scale_tensor,
                out_dtype=torch.bfloat16,
                use_fast_accum=False,
            ),
        ),
        (
            "torch_scaled_mm_scalar_fast_accum",
            lambda: torch_scaled_mm_op(True),
            lambda: torch._scaled_mm(
                per_tensor_fp8(torch, sample_x)[0],
                qweight_tensor_t,
                per_tensor_fp8(torch, sample_x)[1],
                weight_scale_tensor,
                out_dtype=torch.bfloat16,
                use_fast_accum=True,
            ),
        ),
        (
            "sgl_cutlass_rowwise_gemm_only",
            sgl_gemm_op,
            lambda: fp8_scaled_mm(
                sglang_per_token_quant_fp8(sample_x)[0],
                qweight_row_t,
                sglang_per_token_quant_fp8(sample_x)[1],
                weight_scale_row_t,
                torch.bfloat16,
                bias=None,
            ),
        ),
        (
            "sgl_cutlass_dynamic_w8a8",
            sgl_dynamic_op,
            lambda: fp8_scaled_mm(
                sglang_per_token_quant_fp8(sample_x)[0],
                qweight_row_t,
                sglang_per_token_quant_fp8(sample_x)[1],
                weight_scale_row_t,
                torch.bfloat16,
                bias=None,
            ),
        ),
        (
            "triton_rowwise_gemm_only",
            triton_gemm_op,
            lambda: triton_scaled_mm(
                sglang_per_token_quant_fp8(sample_x)[0],
                qweight_row_t,
                sglang_per_token_quant_fp8(sample_x)[1],
                weight_scale_row_t,
                torch.bfloat16,
                None,
            ),
        ),
        (
            "triton_dynamic_w8a8",
            triton_dynamic_op,
            lambda: triton_scaled_mm(
                sglang_per_token_quant_fp8(sample_x)[0],
                qweight_row_t,
                sglang_per_token_quant_fp8(sample_x)[1],
                weight_scale_row_t,
                torch.bfloat16,
                None,
            ),
        ),
    ]

    for name, operation, sample_operation in providers:
        try:
            median_ms, values_ms = elapsed_ms(
                torch,
                operation,
                warmups,
                iterations,
            )
            candidate = sample_operation()
            torch.cuda.synchronize()
            provider = {
                "median_ms": median_ms,
                "values_ms": values_ms,
                "tflops": flops / (median_ms / 1000) / 1e12,
                "speedup_over_bf16": bf16_median / median_ms,
                **similarity(torch, reference, candidate),
            }
        except Exception as exc:
            torch.cuda.synchronize()
            provider = {"error": repr(exc)}
        result["providers"][name] = provider

    result["peak_allocated_mb"] = torch.cuda.max_memory_allocated(device) / (1024**2)

    del x, weight, qinput_row, input_scale_row
    del qweight_row, weight_scale_row, qweight_row_t, weight_scale_row_t
    del qinput_tensor, input_scale_tensor, qweight_tensor, weight_scale_tensor
    del qweight_tensor_t, sample_x, reference
    torch.cuda.empty_cache()
    return result


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--audit-json", type=Path, required=True)
    parser.add_argument("--output", type=Path, required=True)
    parser.add_argument("--max-m", type=int, default=100000)
    parser.add_argument("--max-shapes", type=int, default=4)
    parser.add_argument("--warmups", type=int, default=3)
    parser.add_argument("--iterations", type=int, default=10)
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    shapes = load_shapes(args.audit_json, args.max_m, args.max_shapes)
    if not shapes:
        print(f"[error] no audited FP8 shapes found in {args.audit_json}")
        return 2

    import torch

    if not torch.cuda.is_available():
        print("[error] CUDA is not available")
        return 2

    properties = torch.cuda.get_device_properties(0)
    output: dict[str, Any] = {
        "timestamp": datetime.now(timezone.utc).isoformat(),
        "audit_json": str(args.audit_json),
        "device": {
            "name": properties.name,
            "compute_capability": [
                properties.major,
                properties.minor,
            ],
            "multi_processor_count": properties.multi_processor_count,
            "total_memory_mb": properties.total_memory / (1024**2),
        },
        "torch": torch.__version__,
        "cuda": torch.version.cuda,
        "args": {
            **vars(args),
            "audit_json": str(args.audit_json),
            "output": str(args.output),
        },
        "gpu_state_before": query_gpu_state(),
        "results": [],
    }

    status = 0
    for index, shape in enumerate(shapes, start=1):
        print(
            f"[shape {index}/{len(shapes)}] "
            f"M={shape['m']} K={shape['k']} N={shape['n']}",
            flush=True,
        )
        try:
            result = benchmark_shape(
                shape,
                warmups=args.warmups,
                iterations=args.iterations,
            )
        except torch.cuda.OutOfMemoryError as exc:
            torch.cuda.empty_cache()
            result = {**shape, "error": f"CUDA OOM: {exc}"}
            status = 1
        except Exception as exc:
            torch.cuda.empty_cache()
            result = {**shape, "error": repr(exc)}
            status = 1
        output["results"].append(result)
        args.output.parent.mkdir(parents=True, exist_ok=True)
        args.output.write_text(
            json.dumps(output, ensure_ascii=False, indent=2),
            encoding="utf-8",
        )
        if "error" in result:
            print(f"  error={result['error']}", flush=True)
            continue
        for name, provider in result["providers"].items():
            if "error" in provider:
                print(f"  {name}: ERROR {provider['error']}", flush=True)
            else:
                print(
                    f"  {name}: {provider['speedup_over_bf16']:.3f}x "
                    f"({provider['tflops']:.1f} TFLOPS)",
                    flush=True,
                )

    output["gpu_state_after"] = query_gpu_state()
    args.output.write_text(
        json.dumps(output, ensure_ascii=False, indent=2),
        encoding="utf-8",
    )
    print(f"[output] {args.output}")
    return status


if __name__ == "__main__":
    raise SystemExit(main())
