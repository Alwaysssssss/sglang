      "text": "(gate): Sequential(\n(0): Linear(in_features=4096,\nout_features=10240, bias=False)\n(1): GELU()\n)\n(fc1): Linear(in_features=4096,\nout_features=10240, bias=False)\n(fc2): Linear(in_features=10240,\nout_features=4096, bias=False)\n(dropout): Dropout(p=0.1,\ninplace=False)",
      "fontSize": 31.911322044068104,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "(gate): Sequential(\n(0): Linear(in_features=4096, out_features=10240, bias=False)\n(1): GELU()\n)\n(fc1): Linear(in_features=4096, out_features=10240, bias=False)\n(fc2): Linear(in_features=10240, out_features=4096, bias=False)\n(dropout): Dropout(p=0.1, inplace=False)",
      "autoResize": false,
      "lineHeight": 1.25
    },
