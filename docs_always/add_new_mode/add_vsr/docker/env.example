# Shell configuration: cp env.example .env; edit paths; set -a; source .env; set +a
VSR_IMAGE=sglang-vsr:torch210-cu126
VSR_CONTAINER=vsr-api
VSR_MODE=single
VSR_GPUS=7
# For dual: VSR_MODE=dual and VSR_GPUS=6,7. No CUDA_VISIBLE_DEVICES needed.
VSR_BIND_IP=127.0.0.1
VSR_HOST_PORT=30176
VSR_SHM_SIZE=16g
VSR_CHECKPOINT_HOST=/absolute/path/checkpoint-1300
VSR_WAN_HOST=/absolute/path/Wan2.2-TI2V-5B-Diffusers
VSR_INPUT_HOST=/absolute/path/input
VSR_OUTPUT_HOST=/absolute/path/vsr-output
VSR_CACHE_HOST=/absolute/path/vsr-cache
VSR_TEST_INPUT=/input/input.mp4
# Optional: relocate the exact validated wheel; SHA256 remains enforced.
# VSR_KERNEL_WHEEL=/absolute/path/sglang_kernel-0.4.1-cp310-abi3-linux_x86_64.whl
# Optional: pin an approved base image digest after the first successful build.
# VSR_BASE_IMAGE=python:3.11.12-bookworm@sha256:...
