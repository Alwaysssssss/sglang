VSR_IMAGE=sglang-vsr:l40s
VSR_CONTAINER=vsr-l40s
VSR_NUM_GPUS=1
# Optional exact host IDs; count must match VSR_NUM_GPUS.
# VSR_GPUS=2,3
VSR_BIND_IP=127.0.0.1
VSR_HOST_PORT=30176
VSR_SHM_SIZE=16g
VSR_CHECKPOINT_HOST=/home/zhouhao6/vsr/model/best/checkpoint-1300
VSR_WAN_HOST=/home/zhouhao6/vsr/model/Wan2.2-TI2V-5B-Diffusers
VSR_INPUT_HOST=/home/zhouhao6/vsr/sglang/output_results/vsr/docker-input
VSR_OUTPUT_HOST=/home/zhouhao6/vsr/sglang/output_results/vsr/docker-output
VSR_CACHE_HOST=/home/zhouhao6/vsr/sglang/output_results/vsr/docker-cache
VSR_TEST_INPUT=/input/input.mp4
