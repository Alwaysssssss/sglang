      "text": "sinusoid = torch.outer(\n        position, torch.pow(10000, -\ntorch.arange(half).to(position).div(half)))\n    x = torch.cat([torch.cos(sinusoid),\ntorch.sin(sinusoid)], dim=1)",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "EOMrJnQ5EHFEoucCiz4HD",
      "originalText": "sinusoid = torch.outer(\n        position, torch.pow(10000, -torch.arange(half).to(position).div(half)))\n    x = torch.cat([torch.cos(sinusoid), torch.sin(sinusoid)], dim=1)",
