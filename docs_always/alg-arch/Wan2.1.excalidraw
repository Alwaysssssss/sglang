      "version": 368,
      "versionNonce": 1712479538,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1783321604308,
      "link": null,
      "locked": false,
      "text": "同时用两次 residual 保持原始信息和训练稳定\n性。",
