      "isDeleted": false,
      "boundElements": [],
      "updated": 1783321604308,
      "link": null,
      "locked": false,
      "text": "再让每个 token 单独做一次更强的非线性特征变\n换，",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "再让每个 token 单独做一次更强的非线性特征变换，",
      "autoResize": false,
      "lineHeight": 1.25
    },
