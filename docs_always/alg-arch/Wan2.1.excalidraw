    },
    {
      "id": "aOfqeJV5WkkgE1KNJfAt5",
      "type": "text",
      "x": 943.3298958275527,
      "y": -3840.3925705780066,
      "width": 775.763916015625,
      "height": 90,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
